{
  "name": "dsh-game-material-master",
  "version": "0.12.0",
  "description": "游戏素材大师：DSH 插件，包含八方向图生成、图片生成、序列帧生成、45° 地图编辑器、俯视地图编辑器、音乐生成编辑、音效生成七个正式模块（俯视地图编辑器参考 AsLib 的 RPG Map Maker 重做：一屏、纯图标、零术语，地图四周环绕、素材自动识别与自动连接、动画地块、内置素材、一键生成，全本地零计费；音乐生成编辑接谱乐 AI：灵感/歌词 → 不挂靠项目的新对话 → agent 扩写/选引擎生成 → 回界面裁剪/音量/淡入淡出/标准化/导出，生成按平台积分计费；另有谱曲模式：先给方案 → scoremill 本地写 MIDI → 渲染试听 → 逐版修改 → 可选交 Suno，谱曲/试听/导出本地免费；音效生成接火山引擎 Seed-Audio：一句话描述 → 音效/环境音/角色配音，可带参考图或参考音频，每次生成真实计费），以及实验性的骨骼动画生成模块与正式的全本地 45° 地图编辑器。界面与内置提示词跟随 DSH 语言设置（中 / 英）。八方向图默认「转圈截帧」（一段原地匀速转一圈的绿幕视频 → 按时间轴截出八个方向），也可逐方向生图；45° 地图编辑器用 2:1 等距菱形地块、自动连接与多格物件拼成一张地图，全本地免费。生图后端可选火山方舟 Seedream，或自定义生图模型（OpenAI API / ComfyUI API / Stable Diffusion WebUI API 三种协议）；图生视频走 MiniMax；抠绿幕合成与音乐后期全部在本地。",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/universe-st/dsh-game-material-master.git"
  },
  "homepage": "https://github.com/universe-st/dsh-game-material-master#readme",
  "bugs": {
    "url": "https://github.com/universe-st/dsh-game-material-master/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "files": [
    "lib",
    "README.md",
    "README.en.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/strip-client-export.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:rig:runtime": "node scripts/verify-rig-runtime.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@esotericsoftware/spine-core": "4.2.120",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "game-assets",
    "sprite-sheet",
    "chroma-key",
    "seedream",
    "minimax",
    "tilemap-editor",
    "tileset",
    "autotile",
    "wraparound",
    "music-generation",
    "ai-music",
    "scoremill",
    "midi-composition",
    "audio-editing",
    "puyue",
    "suno",
    "sound-effects",
    "sfx",
    "seed-audio",
    "volcengine",
    "isometric",
    "45-degree",
    "map-editor"
  ]
}
